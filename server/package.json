{
  "name": "@play-holiday/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/start.ts",
    "start": "node --enable-source-maps dist/src/start.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.2.1",
    "fastify": "^5.11.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "prisma": "^7.9.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
