{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src", "tests", "prisma.config.ts", "prisma"]
}
